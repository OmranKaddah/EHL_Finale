# Local defaults for `atira models proxy`; load explicitly if needed.
QWEN_BASE_URL=http://127.0.0.1:8765/qwen/v1
QWEN_API_KEY=local
QWEN_MODEL=qwen
CLEF_BASE_URL=http://127.0.0.1:8765/clef
CLEF_API_KEY=local

# Local GPT rehearsal: scripts/rehearse_rfq.sh (or rfq-agent --model gpt-6-luna)
# Put OPENAI_API_KEY=your-key in the local .env file (this example is safe to commit).
# Public Atira test/scored runs use the supplied Qwen/Clef model proxy.

# Use `atira scout --env` for the task brief and site credentials.
# Attach to an existing local browser; see docs/RFQ_AGENT.md.
CDP_URL=http://127.0.0.1:9222
# Four existing local browsers, each with its own debugging port/profile:
# CDP_URLS=["http://127.0.0.1:9222","http://127.0.0.1:9223","http://127.0.0.1:9224","http://127.0.0.1:9225"]

# Test/scored runs receive CHALLENGE_API_URL, CHALLENGE_RUN_TOKEN,
# LLM_PROXY_URL, CDP_URL(S), and model proxy configuration from Atira.
# Do not commit tokens, site credentials, or CHALLENGE_SCOUTING contents.
