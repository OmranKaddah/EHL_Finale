# Values are supplied by Atira. Do not put actual credentials in this file.
# Local: atira scout --env | Out-String | Invoke-Expression
ATIRA_MODEL_PROVIDER=qwen
# Hybrid uses Atira-proxied Qwen plus Atira-proxied OpenAI. It needs explicit
# paid-provider approval and model name; never place a raw provider key here.
# ATIRA_MODEL_PROVIDER=hybrid
# ATIRA_ALLOW_PAID=1
# ATIRA_OPENAI_MODEL=<Atira-enabled model>
# ATIRA_MODEL_ROLE_ROUTING={"tender":"openai","specifications":"openai","erp":"qwen","mail":"qwen","submission":"openai"}
ATIRA_MODEL=qwen
ATIRA_ALLOW_PAID=0
ATIRA_BUDGET_SECONDS=1200
ATIRA_SUBMISSION_RESERVE=180
ATIRA_DASHBOARD_PORT=8787
