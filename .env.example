OPENAI_API_KEY=
OPENAI_PARSER_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DOCUMENT_PARSER=llm
EXTRACTION_BACKEND=llm
LLM_PDF_DETAIL=auto
MAX_DOCUMENT_SIZE_MB=40
CHUNK_SIZE=3000
CHUNK_OVERLAP=200
TABULAR_ROWS_PER_TABLE=500
LOCAL_EXTRACTION_MODEL=fastino/gliner2.5-multi-v1
EMBEDDING_DIMENSIONS=1536
ENABLE_EMBEDDINGS=false
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=change-me
TYPESENSE_COLLECTION=document_chunks_v1
MAX_CONCURRENT_WORKERS=4
MAX_CONCURRENT_LLM_REQUESTS=4
JOB_TIMEOUT_SECONDS=150
WINDOW_DURATION_SECONDS=180
PROCESSING_MODE=balanced
SCHEDULING_POLICY=earliest_deadline_first
SQLITE_PATH=hackkit.db
LOG_LEVEL=INFO
ENABLE_TYPESENSE=false
ENABLE_CACHE=true
DRY_RUN=true
